{
  "name": "hosted",
  "version": "1.0.0",
  "about": "For the tests: phrases the host runs in JavaScript, the way a browser extension's are. Only a core with a host has it.",
  "runs": "host",
  "shapes": {
    "echoed": "{x}"
  },
  "groups": [
    {
      "name": "hosted",
      "needs": [
        "none"
      ]
    }
  ],
  "functions": [
    {
      "name": "echo",
      "group": "hosted",
      "description": "Gives back what it was given.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "x": {}
        },
        "required": [
          "x"
        ]
      },
      "outputSchema": {}
    },
    {
      "name": "boom",
      "group": "hosted",
      "description": "Fails with it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {}
        },
        "required": [
          "message"
        ]
      }
    },
    {
      "name": "slow",
      "group": "hosted",
      "description": "Waits, then says woke.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "seconds": {
            "default": 1
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "string"
      }
    },
    {
      "name": "press",
      "group": "hosted",
      "description": "Needs a permission the tests don't give.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "string"
      },
      "onsay": {
        "needs": [
          "screen.act"
        ]
      }
    }
  ]
}
