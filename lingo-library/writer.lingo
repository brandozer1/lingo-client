// writer.lingo - Writes lingos for you. Say what a lingo should do, like a lingo that tells me the weather for a city, and
// it writes its Lingo code, one file, reviewed and fixed by a second look, ready to put in your computer's lingos
// folder. It changes a lingo you already have the same way. An AI model writes them through
// OpenRouter, on your own key: a strong coding model writes the best ones.
//
// 1. write(request, chat=nothing, model=nothing)  -> made: a new lingo that does what request says, chat the chat before it
// 2. revise(name, code, change, model=nothing)    -> made: the lingo name, its code, changed as asked
// made = {name, file, code, notes}: file is <name>.lingo, notes in plain words what it made, the settings to set and the
// lingos it calls. model is any OpenRouter model id, else this lingo's model setting, else openrouter's. A model drafts
// it, a second pass reviews it against a checklist, and a third fixes what the review found, at most twice, so at most
// 5 asks. Its code isn't loaded to check it: the computer does that when the person puts the file in its lingos folder,
// and the notes say so. Nothing is saved.

////////// 1-2. WRITING //////////

// 1. Writes a new lingo from a plain description of what it should do, like a lingo that tells me the weather for a
// city: its Lingo code, one file, ready to put in the computer's lingos folder. Use it only when the person asks for a
// lingo to be written, made, created or built. Not for chatting, answering questions or doing the task itself. notes
// says what it made, the settings to set and the lingos it calls. request is what the lingo should do, in plain words.
// chat is the conversation before the request, oldest first: a list of {from, text}, from being you or onsay.
fn write(request, chat=nothing, model=nothing) {
  said = []
  for t in chat ?? [] {said += [{role: t.from == "you" ? "user" : "assistant", content: t.text}]}
  return made(said + [{role: "user", content: "Write a new lingo that does this: {request}"}], model, nothing)
}

// 2. Changes a lingo the person already has, as they ask, like add a function for tomorrow's weather, and gives back its
// code changed and reviewed again. Use it only when they ask to change, edit, fix or add to a lingo and give
// its code. Not for chatting or doing the task itself. name is the lingo's name, like weather, code its whole .lingo
// file, and change what to change, in plain words. Its name stays, and so does everything the change doesn't touch.
fn revise(name, code, change, model=nothing) {
  if text.trim(std.text(code ?? "")) == "" {fail "To change a lingo, give its code: the whole of its .lingo file"}
  ask = "Change this lingo as asked, keeping its name, {name}, and everything the change doesn't touch. The change: {change}\n\n"
  return made([{role: "user", content: ask + shown({name: name, code: code})}], model, name)
}

////////// HELPERS //////////

// The draft, then each round a review and a fix while the review or the checks find problems, at most 2 rounds. For
// writer's own use.
fn made(said, model, name) {
  m = model ?? setting("model")
  if m == "" {m = nothing}
  messages = [{role: "system", content: "You write lingos for Onsay. " + answer() + "\n\n" + guide()}] + said
  d = asked(messages, m, name)
  for turn in 1..2 {
    problems = checked(d) + reviewed(said, d, m)
    if std.length(problems) == 0 {return result(d, [])}
    messages += [{role: "assistant", content: answer(d)}, {role: "user", content: "A review found these problems:\n- " + text.join(problems, "\n- ") +
      "\nFix every one, change nothing else, and answer with the whole lingo again, the same way."}]
    d = asked(messages, m, name)
  }
  return result(d, checked(d))
}

// The model's lingo, its name as a lingo's name: lower case words joined by _. For writer's own use.
fn asked(messages, model, name) {
  a = answered(openrouter.chat(messages, model))
  if json.kind(a.code) != "text" {
    fail "The model's answer had no code in it, so nothing was written. Try again, or set a stronger model in your settings for writer"
  }
  n = name ?? text.case(a.name ?? "", "snake")
  if n == "" {fail "The model's lingo had no name, so nothing was written. Try again, saying what it should be called"}
  return {name: n, code: a.code, notes: std.text(a.notes ?? "")}
}

// The problems a second model finds, reading the lingo against the checklist. For writer's own use.
fn reviewed(said, d, model) {
  asks = []
  for t in said {asks += [t.content]}
  a = answered(openrouter.chat([
    {role: "system", content: "You review lingos written for Onsay, against the guide they were written by.\n\n" + guide()},
    {role: "user", content: "What was asked:\n" + text.join(asks, "\n") + "\n\nThe lingo, as written:\n\n" + shown(d) + "\n\n" + checklist()},
  ], model))
  out = []
  for p in json.kind(a.problems) == "list" ? a.problems : [] {out += [std.text(p)]}
  return out
}

// What can be checked without a model: a comment above each fn, and no em dash. For writer's own use.
fn checked(d) {
  out = []
  if std.from_bytes([226, 128, 148]) in d.code + d.notes {
    out += ["It has an em dash in it: write a comma, a colon or a full stop instead"]
  }
  before = ""
  for line in text.lines(d.code) {
    l = text.trim(line)
    head = text.split(l, "\{")[0]
    if text.starts_with(l, "fn ") and not text.starts_with(before, "//") {
      out += ["{head} has no comment right above it saying what it does, when to use it and when not to, so Onsay can't find it"]
    }
    before = l
  }
  return out
}

// What the model said, read as JSON past any words or fence around it, with the code from its lingo block, so the code
// is never escaped inside JSON. For writer's own use.
fn answered(said) {
  t = ""
  code = nothing
  for i, p in text.split(std.text(said ?? ""), "```") {
    first = text.split(p, "\n")[0]
    if i % 2 == 1 and text.trim(first) == "lingo" {code = std.slice(p, std.length(first) + 1)} else {t += p}
  }
  t = std.slice(t, std.length(text.split(t, "\{")[0]))
  t = std.slice(t, 0, std.length(t) - std.length(text.split(t, "\}")[-1]))
  a = json.parse(t)
  if json.kind(a) != "record" {
    fail "The model didn't answer in JSON, so nothing was written. Try again, or set a stronger model in your settings for writer"
  }
  if code != nothing {a.code = code}
  return a
}

// The lingo as the person gets it: its file, and notes on what to set, what it calls and what is still wrong. For
// writer's own use.
fn result(d, left) {
  notes = text.trim(d.notes) == "" ? [] : [text.trim(d.notes)]
  set = []
  for part in std.slice(text.split(d.code, "setting(\""), 1) {
    s = text.split(part, "\"")[0]
    rest = text.trim(std.slice(part, std.length(s) + 1))
    if not (s in set) and std.slice(rest, 0, 1) == ")" {set += [s]}
  }
  if std.length(set) > 0 {notes += ["Then set these in its settings on Onsay, for {d.name}: " + text.join(set, ", ") + "."]}
  calls = []
  for l in ["request", "json", "text", "list", "math", "url", "encode", "time", "openrouter"] {if l + "." in d.code {calls += ["{l}.lingo"]}}
  if std.length(calls) > 0 {notes += ["It calls " + text.join(calls, ", ") + ", so they go in the same lingos folder."]}
  if std.length(left) > 0 {notes += ["Still to fix before you use it: " + text.join(left, "; ") + "."]}
  notes += ["To add it, put {d.name}.lingo in your computer's lingos folder. It hasn't been loaded to check it: the Lingos page on Onsay shows whether it loads there, and why not when it doesn't."]
  return {name: d.name, file: "{d.name}.lingo", code: d.code, notes: text.join(notes, "\n")}
}

// The lingo's file, as the models read it. For writer's own use.
fn shown(d) {
  return "{d.name}.lingo:\n" + d.code
}

// How the writing model answers, and its answer written that way. For writer's own use.
fn answer(d=nothing) {
  if d != nothing {return "```json\n" + std.to_json({name: d.name, notes: d.notes}) + "\n```\n```lingo\n" + d.code + "\n```"}
  return "Answer with its name and notes as one JSON object, then its whole code in a lingo block, and nothing else:
```json
\{\"name\": \"weather\", \"notes\": \"what it does and how to use it, in one or two plain sentences\"\}
```
```lingo
the whole weather.lingo file
```"
}

// What the review checks, and how it answers. For writer's own use.
fn checklist() {
  return "Check it against each point, and list every real problem:
1. It is one file of fn blocks: no tool, no steps and no names set outside a function.
2. The comment lines right above each fn say what it gives or does, when to use it, and when not to, and what its values are, in words a search for the task would match. The first comment lines of the file, before a blank line, say what the lingo is for.
3. The code is Lingo as the guide says: \\\{ and \\\} for braces meant as themselves in text, no quotes inside \{\} in text, one comparison at a time, a record set before its parts, every phrase with its group, nothing called that doesn't exist.
4. A lingo of the library is called by its dotted name, like request.get(...), and anything somewhere else is reached with use(\"address\", values). No other dotted call.
5. Each key or token it needs is read with setting\(\"key\"), never written in the code or taken as a value, and a missing one fails in plain words saying where to add it.
6. The web goes through request, or use(...) for a plain request, at real addresses of real services, with their real fields and answers. Nothing made up.
7. It checks an answer is ok before reading it, and its errors say in plain words what went wrong and what to do.
8. It does all of what was asked, and nothing more, small and readable.
9. Plain words everywhere, and no em dash anywhere.
Answer with one JSON object and nothing else: \{\"problems\": [\"each problem, short and exact, naming the function and what to change\"]\}, or \{\"problems\": []\} when it is right. Never list a matter of taste."
}

// The guide to Lingo and to writing a lingo both models read, with a lingo from Onsay's own library as an example. For
// writer's own use.
fn guide() {
  return "A lingo is one file of Lingo code, <name>.lingo, in a computer's lingos folder, and it runs there. Onsay reads the code itself to know what it shares: every fn is a function anyone can call at its address, the comments right above a fn say what it does, and Onsay finds a function by those words and calls it there, for whoever asks, with their own settings. There is no other file to write. Write lingos that load the first time, do exactly what was asked, and read plainly.

LINGO
- Whitespace never matters. // starts a comment. Names are letters, digits and _, not starting with a digit, and case matters.
- Keywords, never names: if else while for in break continue fn return tool try catch fail and or not true false nothing. null is nothing. After a dot they are fine: r.in.
- A lingo's file holds only fn blocks: no steps outside them, no tool, no names set outside a function. A value used in many places is a small fn that returns it.
- fn name(a, b=1, c=nothing) \{...\}. A function is called by its name with its values in order, from before or after where it is written. A default is worked out when its value is missing or nothing, and a plain one, a number, text, true, false or nothing, is what its listing shows. Functions are not values: they can't be kept in a name, passed or returned, and there are no lambdas.
- Values: nothing, true, false, numbers (3, 0.5), text in double quotes, lists [1, \"a\"] counted from 0, and records \{name: \"Ann\", \"two words\": 1\}. Only nothing and false count as false: 0, \"\" and [] are true.
- In text, \\n is a new line, \\t a tab, \\\" a quote and \\\\ a backslash. \{expression\} puts a value in text: \"Hi \{name\}, \{n + 1\} new\". So a brace meant as itself is written \\\{ or \\\}, JSON in text too: \"\\\{\\\"a\\\": 1\\\}\". The expression inside \{\} can't hold quotes: put that value in a name first. Text can't hold a carriage return: std.from_bytes([13]) is one.
- Setting a name copies the value: a = [1]; b = a; b += [2] leaves a as [1]. Names belong to the function they are set in, blocks make no new ones, and a name never set reads as nothing.
- Statements: x = e, x.part = e, x[i] = e, x += e (and -= *= /=), list += [item] to add one, if c \{...\} else if c \{...\} else \{...\}, while c \{...\}, for x in e \{...\}, for k, v in e \{...\}, break, continue, return e, return, fail e, try \{...\} catch e \{...\}. Blocks always have braces, and conditions need no parentheses. A step on its own must be a call: x + 1 alone is an error.
- for goes through a list's items (k, v: the position and the item), a record's part names (k, v: the name and its value), text's characters, a..b's whole numbers from a to b, both included, and nothing not at all.
- Operators, loosest first: c ? a : b, then a ?? b (b when a is nothing), or, and, not, then == != < > <= >= in (one at a time: never a < b < c), a..b, + -, * / %, unary -, and last x.part, x[i] and calls. + adds numbers, joins lists, and joins as text when either side is text. < and > take two numbers or two texts. a in b: an item of a list, part of a text, or a part name of a record. == compares lists and records by what is in them.
- Reading never fails: a missing part, an item out of range, or a part of nothing is nothing, so r.a.b is nothing when r has no a, and -1 is the last item. Setting a part needs a list or record there: r = \{\} first, then r.a = 1.
- Errors: fail \"plain words\" stops with that message. try \{...\} catch e \{...\} catches it, e being the message, and catches a phrase that failed or a value of the wrong kind too.
- The language is this syntax and three calls: use(...), setting(...) and lingo(...), below. Everything else is a lingo.
- The core, a lingo every computer has, gives only what Lingo can't write for itself, each phrase written with its group:
  std: length(x), keys(r), slice(x, from, to=nothing) (list or text, to not included, below 0 counts from the end), number(x) (from text like \"$1,204.50\", or nothing), text(x), to_json(x), from_json(text) (fails on bad JSON), bytes(text), from_bytes(list).
  compute: now() (seconds since 1970, UTC), wait(seconds) (at most 60), log(x).
  store: get(key) (text, or nothing), put(key, value) (kept as text), keys(prefix=\"\"), delete(key): small things a lingo remembers for the person.
  http: send(method, url, headers=nothing, body=nothing, timeout=30) -> \{status, headers, text\}. Use request instead.
  So write std.length(x), never length(x). Splitting, joining, case, rounding, sorting and dates are lingos in the same folder, below, like text.split(t, \",\"), math.round(n) or list.sort(rows, \"price\"). Whether text holds a part is part in t. There is no index_of, map, filter, push or format: write a loop.
- A dotted call is local: a phrase above, or a function of a lingo in the same lingos folder, by its name, like request.get(...) or text.slug(title). Any other dotted call doesn't load, so call only what this guide names.
- use(\"address\", values) reaches anything somewhere else, in one line, and gives back its answer: a lingo's function at its address, like use(\"laptop.brandon/lingos/text.lingo/slug\", \{text: \"Hi there\"\}), the computer, then the lingo's file and its function; an MCP tool, like use(\"https://mcp.example.com/mcp#search\", \{q: \"x\"\}); or a plain web address, like use(\"https://api.example.com/v1/items\"), a GET with no values and a POST of the values as JSON with them, giving the answer read as JSON when it is JSON, else its text, and failing in plain words on any status but 2xx. An @ in the address sends the answer on: use(\"laptop.brandon/lingos/check.lingo@desktop.brandon/lingos/show.lingo/print\"). For headers, other methods or tries again, use request.
- setting\(\"key\") is the person's own setting of that name for this lingo, or nothing when they haven't set it. Onsay reads which settings a lingo has from its setting\(\"...\") calls and shows them on the dashboard, a name like key, token, secret or password as a secret. setting\(\"token\", \"github\") reads another lingo's.
- lingo\(\"what to do, in words\", \{city: \"Paris\"\}, \"what should come back\") has Onsay find a function that does it, run it, and give back its answer. Use it only when no lingo here does the job.

LINGOS IT CAN CALL
Each is a file in the same lingos folder, called by its name and a dot, with nothing to list: request.get(...). The person puts the ones it calls beside it.
- request.lingo: send(method, address, options=nothing), get(address, options=nothing), post(address, body=nothing, options=nothing), put and patch the same, delete(address, options=nothing). options: headers (a record), query (a record), json or text (the body), timeout (seconds), retries (more tries after a 429, a 5xx or a network that failed). A record or list body goes as JSON. Each gives \{status, ok, headers, text, json\}, json read when the answer is JSON, and never fails on a status: check ok.
- json.lingo: parse(text, fallback=nothing) (the fallback when it isn't JSON), stringify(value, indent=0), get(value, path, fallback=nothing) (a path like \"a.b[0].c\"), merge(a, b), kind(value) (nothing, bool, number, text, list or record).
- text.lingo: split(text, sep=\",\"), join(list, sep=\"\"), replace(text, find, with) (every one), trim(text), lower(text), upper(text), pad(text, width, fill=\" \", at=\"end\"), truncate(text, most, ending=\"...\"), slug(text), case(text, style) (title, sentence, camel, pascal, snake, kebab or constant), template(text, values) (for \"Hi \\\{name\\\}\"), words(text), lines(text), repeat(text, times, sep=\"\"), and starts_with, ends_with and contains(text, part, ignore_case=false).
- list.lingo: sort(list, part=nothing) (smallest first, records by a part), reverse(x) (a list or text, last first).
- math.lingo: round(n, places=0, mode=\"nearest\") (mode nearest, up or down), min(a, b), max(a, b).
- url.lingo: parse(address) -> \{scheme, user, host, port, path, query, hash\}, build(parts), join(base, path), to_query(values), from_query(text), encode(text), decode(text).
- encode.lingo: base64(text, url_safe=false), and from_base64, url, from_url, html, from_html, hex and from_hex, each (text).
- time.lingo: now(), parse(text) (ISO, or nothing), format(time, pattern=\"YYYY-MM-DDTHH:mm:ssZ\", offset=0) (like \"dddd D MMMM YYYY, h:mm a\"), add(time, amount, unit=\"seconds\") (seconds to years), difference(a, b, unit=\"seconds\") (\"days\" for the days between two ISO dates), ago(time, now=nothing), start_of_day(time, offset=0), day_of_week(time, offset=0), now_in_words(zone=nothing) (the date and time now in words, like Tuesday 20 October 2026, 3:42 PM, zone hours from UTC). A time is seconds since 1970 in UTC, and offset hours from UTC.
- openrouter.lingo: ask(prompt, model=nothing), chat(messages, model=nothing) (messages [\{role, content\}]), reply(messages, tools=nothing, model=nothing): an AI model, on the person's own OpenRouter key, for one answer with no conversation of its own.

THE WEB
Reach it through request, or with use(...) for one plain request. Use only real services you know well, at addresses, with values and answers you are sure of, and those that need no key when one will do, like Open-Meteo for weather. When a service needs a key, read it with setting\(\"key\"), and a missing one fails in plain words: fail \"Weather needs your API key: add it in your settings for weather on Onsay. Get one at ...\". Never make up a service, an address or a field: when you aren't sure of one, say so in notes.

THE FILE
- name: lower case letters, digits and _, starting with a letter, like weather or stock_price. The file is <name>.lingo.
- Its first lines are comments saying what the lingo is and does, in a sentence or two, in the words people would search with, starting with its file's name: // weather.lingo - The weather now anywhere... Then an empty //, a numbered list of its functions, each with its values and what it gives, and a blank line.
- Right above each fn, its comment lines, starting with its number: what it gives or does, when to use it, and when not to, in plain words a search can match, short and concrete, and what its values are: // 1. The weather now in a city: its temperature, wind and sky. Use it for what is it like outside, or is it raining in Paris. Not for a forecast of days ahead. city is the city's name. A helper's comment ends: For weather's own use.
- Its settings are only its setting\(\"...\") calls. A key or token is always a setting, never in the code and never a function's value. A default is applied in the code: setting\(\"units\") ?? \"metric\".

HOW IT IS WRITTEN
- Small and readable: the fewest functions that do the job well, each short. The functions it is for first, then its helpers.
- Comments only where the code can't say it, but always the one right above each fn.
- Each error says what went wrong and what to do next, in plain words: fail \"There's no city called \{city\}: check its spelling\". Check an answer is ok before reading it.
- Plain words everywhere: comments, notes and errors. Never an em dash: use a comma, a colon or a full stop.

AN EXAMPLE, FROM ONSAY'S OWN LIBRARY
```lingo
// openrouter.lingo - AI models through OpenRouter, on your own OpenRouter API key: GPT, Claude, Gemini, Llama, Mistral,
// DeepSeek, Qwen and hundreds more, for a program that needs a model to answer, write, summarize or translate. It keeps
// no conversation and uses no lingos: to chat with the person, use the agent.
//
// 1. ask(prompt, model=nothing)                    -> text: one question's answer
// 2. chat(messages, model=nothing)                 -> text: the next reply in a conversation
// 3. reply(messages, tools=nothing, model=nothing) -> message: the next reply whole, \{role, content, tool_calls\}, the
//                                                     model given tools in OpenAI's format, the way an agent asks
// Its settings, key, model and url, are the person's, set on the dashboard for openrouter and read with setting(...).

// 1. Asks one AI model one question for a program and gives its answer as text. It sees only this prompt: no chat, no
// memory and no other lingos. Not for chatting with the person or answering them in the chat: the agent does that.
// prompt is the whole question or task for the model, with everything it needs to know. model is an OpenRouter model
// id, like openai/gpt-4o-mini. The one in settings when left out.
fn ask(prompt, model=nothing) \{
  return chat([\{role: \"user\", content: prompt\}], model)
\}

// 2. An AI model's next reply to messages a program already has, each \{role, content\}, role being system, user or
// assistant. For a program keeping its own conversation with a model. Not for chatting with the person in Onsay's chat:
// the agent does that. messages is the messages so far: a list of \{role, content\}, role being system, user or
// assistant. model is an OpenRouter model id, like openai/gpt-4o-mini. The one in settings when left out.
fn chat(messages, model=nothing) \{
  return reply(messages, nothing, model).content
\}

// 3. An AI model's next message whole, \{role, content, tool_calls\}, given tools it may ask for in OpenAI's format. For
// a program building an agent of its own. Not for chatting with the person. messages is the messages so far: a list of
// \{role, content\}, with tool_calls and tool messages as OpenAI has them. tools is the tools the model may ask for, each
// \{type: \"function\", function: \{name, description, parameters\}\}. model is an OpenRouter model id, like
// openai/gpt-4o-mini. The one in settings when left out.
fn reply(messages, tools=nothing, model=nothing) \{
  key = setting(\"key\")
  if key == nothing or key == \"\" \{
    fail \"OpenRouter needs your API key: add it in your settings for openrouter on Onsay. Get one at openrouter.ai/keys\"
  \}
  base = setting(\"url\") ?? \"https://openrouter.ai/api/v1\"
  body = \{model: model ?? setting(\"model\") ?? \"openai/gpt-4o-mini\", messages: messages\}
  if tools != nothing \{body.tools = tools\}
  r = request.post(\"\{base\}/chat/completions\", body, \{headers: \{Authorization: \"Bearer \{key\}\"\}, retries: 2\})
  if r.status == 401 \{
    fail \"OpenRouter turned the API key down: check it in your settings for openrouter on Onsay\"
  \}
  if not r.ok \{
    fail \"OpenRouter answered \{r.status\}: \{r.text\}\"
  \}
  return r.json.choices[0].message
\}
```"
}
