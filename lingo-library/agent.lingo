// agent.lingo - Onsay's chat assistant, the one the person talks to in Onsay's chat. An AI model answers through
// OpenRouter on their own key, reading the whole conversation, and uses any other lingo it needs on the way.
//
// 1. ask(prompt, chat=nothing, model=nothing) -> text: the model's reply, after at most 8 turns. chat is the turns before
//                                  the prompt, each {from: you or onsay, text}, as the desktop chat gives them, and model
//                                  any OpenRouter model id, the one in openrouter's settings when left out
// The model has two tools: lingo(task, values), the lingo function itself, and use(address, values), anything named by its
// address. Each tool's answer, or what went wrong, goes back to the model, until it replies. Only that reply comes back.

////////// 1. ASK //////////

// 1. The chat assistant answers what the person just said, reading the conversation so far. Use it for anything said to
// Onsay in a chat: greetings, small talk, questions, questions about the conversation like what did I just say, and
// tasks that need other lingos. Not for a program that only needs one answer from an AI model. prompt is what the
// person just said, in their own words. chat is the conversation before it, oldest first: a list of {from, text}, from
// being you or onsay. Give it whenever there is one. model is an OpenRouter model id, like openai/gpt-4o-mini, the one
// in openrouter's settings when left out.
fn ask(prompt, chat=nothing, model=nothing) {
  said = [{role: "system", content: guide()}]
  for t in chat ?? [] {said += [{role: t.from == "you" ? "user" : "assistant", content: t.text}]}
  said += [{role: "user", content: prompt}]
  turns = 8
  for turn in 1..turns {
    m = openrouter.reply(said, tools(), model)
    if std.length(m.tool_calls ?? []) == 0 {return m.content ?? ""}
    said += [{role: "assistant", content: m.content, tool_calls: m.tool_calls}]
    for c in m.tool_calls {said += [{role: "tool", tool_call_id: c.id, content: used(c.function)}]}
  }
  return "I took {turns} turns and still hadn't finished, so I stopped. Try asking for less at once."
}

////////// HELPERS //////////

// What the agent's model is told it is, and what its tools are for. For the agent's own use.
fn guide() {
  return "You are Onsay's chat agent, an AI model the person talks to in Onsay's chat, and you run as a lingo, a small " +
    "program on one of their computers. Answer plainly and truthfully. The messages before this one are your conversation with the " +
    "person so far: use them, and quote them exactly when asked what was said. You have two tools. lingo(task, values) is the lingo function: Onsay " +
    "finds the lingo that does the task, runs it and gives back only its answer. Use it for anything you can't know or do " +
    "yourself, like the time now, the weather, a web page, writing a lingo, or something on the person's computers, " +
    "instead of saying you can't: say the task in plain words with every detail it needs, and give any values it needs " +
    "by name in values, like city for the weather. use(address, values) reaches what an address names and gives back its answer: " +
    "a lingo's function, like laptop.brandon/lingos/text.lingo/slug with the value text, an MCP tool after a #, or a web address, " +
    "asked with no values or sent them as JSON, when the person or an answer names one. So when you are asked whether " +
    "you can use the lingo function, or what you can do, say yes and name these two tools. A tool that fails says why: " +
    "try another way, or tell the person. When you have what you need, reply."
}

// The agent's tools, in OpenAI's format. The first value each takes is the one it needs. For the agent's own use.
fn tools() {
  return [
    offered("lingo", "The lingo function: Onsay finds the lingo that does a task, runs it, and gives back its answer. For anything you can't know or do yourself", {
      task: {type: "string", description: "What to do, in plain words, with every detail it needs"},
      values: {type: "object", description: "The values it needs, by name, like city for the weather, or none"},
    }),
    offered("use", "Reaches what an address names and gives back its answer: a lingo's function, like laptop.brandon/lingos/text.lingo/slug, an MCP tool, or a web address", {
      address: {type: "string", description: "What to reach: a computer, then the lingo's file and its function, like laptop.brandon/lingos/text.lingo/slug, or a web address"},
      values: {type: "object", description: "Its values by name, like text for text.lingo/slug, or none"},
    }),
  ]
}

// One tool for the model, in OpenAI's format. For the agent's own use.
fn offered(name, does, takes) {
  return {type: "function", function: {name: name, description: does, parameters: {type: "object", properties: takes, required: [std.keys(takes)[0]]}}}
}

// What a tool the model asked for gave, as text, or what went wrong, in plain words. It never reaches itself: its lingo
// tool never picks it, since a lingo(...) never picks the function asking, and its use tool refuses an address of it.
fn used(f) {
  try {
    a = std.from_json(f.arguments) ?? {}
    if f.name == "lingo" {
      got = lingo(a.task, a.values)
    } else if f.name == "use" and itself(a.address) {
      return "That is this agent, which would only ask itself again: answer, or use another lingo"
    } else if f.name == "use" {
      got = use(a.address, a.values)
    } else {
      return "There's no tool called {f.name}: there are lingo and use"
    }
    return std.text(got ?? "It gave nothing back")
  } catch e {
    return "That didn't work: {e}"
  }
}

// Whether an address names this agent, like laptop.brandon/lingos/agent.lingo/ask.
fn itself(address) {
  return "/agent.lingo" in text.lower(address)
}
